{
  "name": "agent-vibe-voice-cskh-backend",
  "version": "1.0.0",
  "description": "Enterprise Express TypeScript Backend for Banking CSKH & Debt Collection AI Voicebot/Chatbot",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "voicebot",
    "chatbot",
    "banking",
    "cskh",
    "debt-collection",
    "express",
