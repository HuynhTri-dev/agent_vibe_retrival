# Server Configuration
PORT=3000
NODE_ENV=development

# Voice Pipeline & Telephony
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
TELEPHONY_SIP_PROVIDER=twilio
TELEPHONY_WEBHOOK_SECRET=your_sip_webhook_secret

# Core Banking Mock/Live API
CORE_BANKING_API_URL=https://api.internal-bank.com/v1
CORE_BANKING_API_KEY=your_banking_api_key

# Debt Collection & CRM
COLLECTION_CRM_API_URL=https://crm.internal-bank.com/v1
COLLECTION_CRM_API_KEY=your_crm_api_key

# SMS / ZNS Notification Gateway
SMS_GATEWAY_URL=https://sms-gateway.internal-bank.com/v1
SMS_BRANDNAME=ANBINHBANK
